# Template for the local .env, which cmd/api loads at startup.
#
#   cp example.env .env    # then fill in the values below
#
# Real environment variables take precedence over this file, so deployments set
# them directly and never ship a .env.

# Connection string for PostgreSQL. Required — the service will not boot
# without it. sslmode=disable is for local development only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hospital_middleware?sslmode=disable

# Signing key for issued tokens. Required, and must be at least 32 bytes.
# There is deliberately no default: a shared development secret that reaches
# production would forge every token in the system. Generate your own:
#
#   openssl rand -hex 32
#
# The placeholder below is intentionally too short, so an unfilled copy of this
# file fails at boot instead of running on a secret that is public knowledge.
JWT_SECRET=replace-me

# Port the HTTP server listens on. Optional; defaults to 8000.
PORT=8000

# How long an issued token stays valid, in whole hours. Optional; defaults to
# 12. Ignored if it is not a positive integer.
JWT_TTL_HOURS=12
